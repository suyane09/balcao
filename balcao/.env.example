# Porta do servidor (a hospedagem costuma definir sozinha)
PORT=3000

# E-mail da conta que vai ver a área /admin (a sua). Crie essa conta normalmente em /cadastro.
ADMIN_EMAIL=voce@email.com

# Seu WhatsApp com DDI+DDD (só números). Aparece no aviso de plano vencendo, no painel dos restaurantes.
PLATAFORMA_WHATSAPP=5582999999999

# Dias de teste grátis para cada restaurante novo
DIAS_TESTE=7

# Endereço público do site, usado nas prévias de link do WhatsApp (sem barra no final)
BASE_URL=https://seudominio.com.br

# Pasta onde ficam o banco de dados e as imagens. Em hospedagem, aponte para um disco persistente.
DATA_DIR=./dados
